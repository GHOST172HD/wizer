{
  "name": "wizer",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-24",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/fidelity",
      "/api/fidelity/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "FIDELITY_DB",
      "database_name": "wizer-fidelity",
      "database_id": "227c4050-3f68-42b1-8633-6d6db1697865"
    }
  ]
}
