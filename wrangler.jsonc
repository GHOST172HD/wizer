{
  "name": "wizer",
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-24",
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/fidelity",
      "/api/fidelity/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "FIDELITY_DB",
      "database_name": "wizer-fidelity",
      "database_id": "00000004-00000000-00005111-37ebc1bd856c8cafa4f1cb4879299214"
    }
  ]
}
